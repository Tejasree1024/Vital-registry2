PORT=4000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: server-side only, never ship to web/Android clients
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=change-me-to-a-long-random-string
# Registering with this email creates an admin account
ADMIN_EMAIL=admin@example.com
# Origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
# Used inside QR codes
PUBLIC_WEB_URL=http://localhost:5173
# Optional SMTP for confirmation emails (otherwise stored as in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vital Registry <no-reply@vitalregistry.org>
